<Window x:Class="SchoolJournal.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="700" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Border Background="White" CornerRadius="20" Effect="{StaticResource CardShadow}" Margin="20">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,40">
                <TextBlock Text="📚" FontSize="72" HorizontalAlignment="Center"/>
                <TextBlock Text="Электронный дневник" FontSize="26" FontWeight="Bold" 
                           Foreground="#4A90D9" HorizontalAlignment="Center" Margin="0,15,0,5"/>
                <TextBlock Text="Школьная система" FontSize="16" Foreground="#777777" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Логин" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="LoginTextBox" Height="45" FontSize="15" 
                         BorderThickness="0,0,0,2" BorderBrush="#4A90D9"
                         Background="#F8F9FA" Padding="12,0,0,0" Margin="0,0,0,25"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Пароль" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox" Height="45" FontSize="15" 
                             BorderThickness="0,0,0,2" BorderBrush="#4A90D9"
                             Background="#F8F9FA" Padding="12,0,0,0" Margin="0,0,0,25"
                             VerticalContentAlignment="Center"/>

                <Button x:Name="LoginButton" Content="Войти в систему" Height="50" 
                        Style="{StaticResource PrimaryButton}" 
                        Click="LoginButton_Click" Margin="0,15,0,0" FontSize="16"/>

                <TextBlock x:Name="ErrorMessage" Text="" Foreground="#D9534F" 
           FontSize="13" Margin="0,15,0,0" Visibility="Collapsed" 
           TextWrapping="Wrap" HorizontalAlignment="Center"/>
                
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="© 2026 Школьная система" Foreground="#999999" 
                           FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>