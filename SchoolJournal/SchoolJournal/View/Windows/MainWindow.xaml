<Window x:Class="SchoolJournal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный дневник школьника" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Цветовая схема -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A90D9"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#5CB85C"/>
        <SolidColorBrush x:Key="AccentColor" Color="#F0AD4E"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="GrayText" Color="#777777"/>

        <!-- Тени -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#808080"/>

        <!-- Стили кнопок -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#4A90D9" CornerRadius="0,0,20,20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📚" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Электронный" Foreground="White" FontSize="16" 
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock Text="Дневник" Foreground="White" FontSize="16" 
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,20,10,0">
                        <TextBlock Text="МЕНЮ" Foreground="#999999" FontSize="12" 
                                   FontWeight="Bold" Margin="10,0,0,10"/>

                        <Button Style="{StaticResource NavButton}" Click="Dashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 " FontSize="18"/>
                                <TextBlock Text="Главная" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="JournalButton" Style="{StaticResource NavButton}" Click="Journal_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📖 " FontSize="18"/>
                                <TextBlock Text="Журнал" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DiaryButton" Style="{StaticResource NavButton}" Click="Diary_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝 " FontSize="18"/>
                                <TextBlock Text="Дневник" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="StudentsButton" Style="{StaticResource NavButton}" Click="Students_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👨‍🎓 " FontSize="18"/>
                                <TextBlock Text="Ученики" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TeachersButton" Style="{StaticResource NavButton}" Click="Teachers_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👨‍🏫 " FontSize="18"/>
                                <TextBlock Text="Учителя" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SubjectsButton" Style="{StaticResource NavButton}" Click="Subjects_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚 " FontSize="18"/>
                                <TextBlock Text="Предметы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ParentsButton" Style="{StaticResource NavButton}" Click="Parents_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👪 " FontSize="18"/>
                                <TextBlock Text="Родители" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="MarksButton" Style="{StaticResource NavButton}" Click="Marks_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐ " FontSize="18"/>
                                <TextBlock Text="Оценки" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ReportsButton" Style="{StaticResource NavButton}" Click="Reports_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈 " FontSize="18"/>
                                <TextBlock Text="Отчеты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#F8F9FA" Padding="15" CornerRadius="10" Margin="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="40" Height="40" Fill="#4A90D9"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="UserNameText" Text="Иванов И.И." 
                                           FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="UserRoleText" Text="Учитель" 
                                           Foreground="#777777" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Выйти" 
                                Click="Logout_Click" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="20" 
                    Effect="{StaticResource CardShadow}" CornerRadius="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PageTitle" Text="Панель управления" 
                                   FontSize="28" FontWeight="Bold" Foreground="#333333"/>
                        <TextBlock Text="Добро пожаловать в систему электронного дневника" 
                                   Foreground="#777777" FontSize="14" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentDate" Text="04.05.2026" 
                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" Effect="{StaticResource CardShadow}" 
                    CornerRadius="10" Padding="20">
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Grid>
</Window>