<Page x:Class="SchoolJournal.View.Pages.DiaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DiaryPage" Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E3F2FD" Padding="15" CornerRadius="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Выберите ученика:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="StudentCombo" Grid.Column="1" Padding="5" SelectionChanged="StudentCombo_SelectionChanged"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" Effect="{StaticResource CardShadow}" CornerRadius="10" Padding="10">
            <DataGrid x:Name="DiaryDataGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="White" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Предмет" Binding="{Binding Subject.Name}" Width="*"/>
                    <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="80"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>