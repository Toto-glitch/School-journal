<Page x:Class="SchoolJournal.View.Pages.DiaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Дневник">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Выбор ребёнка для родителя -->
        <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8" Padding="15"
                Visibility="{Binding IsParent, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Выберите ребёнка:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Children}"
                          SelectedItem="{Binding SelectedChild}"
                          DisplayMemberPath="FullName"
                          Width="250"/>
            </StackPanel>
        </Border>

        <!-- Статус -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" Margin="0,10"/>

        <!-- Выбор предмета -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10">
            <TextBlock Text="Предмет:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Subjects}"
                      SelectedItem="{Binding SelectedSubject}"
                      DisplayMemberPath="Title"
                      Width="250"/>
        </StackPanel>

        <!-- Средний балл -->
        <Border Grid.Row="3" Background="#4A90D9" CornerRadius="10" Padding="15"
                HorizontalAlignment="Left" Margin="0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Средний балл:" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AverageMark}" Foreground="White" FontSize="24" FontWeight="Bold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Таблица оценок -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Marks}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Margin="0,20,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="120"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="80"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject.Title}" Width="*"/>
                <DataGridTextColumn Header="Учитель" Binding="{Binding Teacher.LastName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>