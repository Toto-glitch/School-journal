<Page x:Class="SchoolJournal.View.Pages.DiaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding StudentFullName}" 
                   FontSize="18" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Marks}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Margin="0,0,0,15" Background="White" BorderBrush="#D1D5DB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="200"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Averages}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="White" BorderBrush="#D1D5DB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="200"/>
                <DataGridTextColumn Header="Средний балл" Binding="{Binding Avg}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>