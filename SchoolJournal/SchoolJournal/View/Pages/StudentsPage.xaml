<Page x:Class="SchoolJournal.View.Pages.StudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление учениками">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка добавления -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Список учеников" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Добавить ученика" Padding="15,8" FontSize="14"
                    Command="{Binding AddStudentCommand}"
                    Visibility="{Binding IsDirector, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Таблица учеников -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding Group.Title}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding User.Email}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding User.PhoneNumber}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления (только для директора) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"
                    Visibility="{Binding IsDirector, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="Редактировать" Padding="15,8" Margin="0,0,10,0"
                    Command="{Binding EditStudentCommand}"/>
            <Button Content="Удалить" Padding="15,8" Background="#FFE0E0"
                    Command="{Binding DeleteStudentCommand}"/>
        </StackPanel>

        <!-- Диалог добавления/редактирования -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding IsAddDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400">
                <StackPanel>
                    <TextBlock Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Редактирование ученика|Добавление ученика'}"
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="190" Margin="0,0,5,0">
                            <TextBlock Text="Фамилия *" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="5,0,0,0">
                            <TextBlock Text="Имя *" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Отчество" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

                    <TextBlock Text="Группа *" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedGroup}" Padding="8" Margin="0,0,0,10"/>

                    <TextBlock Text="Логин" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

                    <TextBlock Text="Email" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

                    <TextBlock Text="Телефон" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Padding="15,8" Margin="0,0,10,0"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Сохранить|Добавить'}"
                                Padding="15,8" Background="#4CAF50" Foreground="White"
                                Command="{Binding SaveEditCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="Добавить" Padding="15,8" Background="#4CAF50" Foreground="White"
                                Command="{Binding AddStudentCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>