<Page x:Class="SchoolJournal.View.Pages.StudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="StudentsPage" Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content=" Добавить ученика" HorizontalAlignment="Right" 
                Style="{StaticResource PrimaryButton}" Margin="0,0,0,15" 
                Click="AddButton_Click"/>

        <Border Grid.Row="1" Background="White" Effect="{StaticResource CardShadow}" CornerRadius="10" Padding="10">
            <DataGrid x:Name="DataGridList" AutoGenerateColumns="False" CanUserAddRows="False" 
                      IsReadOnly="True" Background="White" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Класс" Binding="{Binding Group.Name}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>