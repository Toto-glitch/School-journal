<Page x:Class="SchoolJournal.View.Pages.SubjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SubjectsPage" Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="➕ Добавить предмет" HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButton}" Margin="0,0,0,15"
                Click="AddButton_Click"/>

        <Border Grid.Row="1" Background="White" Effect="{StaticResource CardShadow}" 
                CornerRadius="10" Padding="10">
            <DataGrid x:Name="DataGridList" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" Background="White" BorderThickness="0" RowHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4A90D9"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Часов в неделю" Binding="{Binding Hours}" Width="130"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>