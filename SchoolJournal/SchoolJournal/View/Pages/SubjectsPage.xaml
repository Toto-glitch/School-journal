<Page x:Class="SchoolJournal.View.Pages.SubjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Предметы">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Список предметов" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
            <Button Content="+ Добавить" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Padding="15,8"
                    Command="{Binding AddSubjectCommand}"
                    Visibility="{Binding IsDirector, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{StaticResource CardBackground}" RowBackground="{StaticResource CardBackground}"
                  AlternatingRowBackground="#F8F9FA" BorderThickness="1" BorderBrush="#E0E0E0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Классов" Binding="{Binding Classes.Count}" Width="80"/>
                <DataGridTextColumn Header="Учителей" Binding="{Binding Teachers.Count}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"
                    Visibility="{Binding IsDirector, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}"
                    Command="{Binding EditSubjectCommand}" Margin="0,0,10,0"/>
            <Button Content="Удалить" Style="{StaticResource SecondaryButton}"
                    Background="#FFE0E0" BorderBrush="#FFB3B3" Foreground="#333"
                    Command="{Binding DeleteSubjectCommand}"/>
        </StackPanel>

        <!-- Диалог -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="25"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="350"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, 
                               ConverterParameter='Редактирование предмета|Новый предмет'}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" 
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Название" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,15,0"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>