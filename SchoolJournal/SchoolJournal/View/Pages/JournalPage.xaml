<Page x:Class="SchoolJournal.View.Pages.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал преподавателя">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Статус -->
        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="14" Margin="0,0,0,15"
                   Foreground="{StaticResource GrayText}"/>

        <!-- Выбор предмета -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Предмет:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding Subjects}"
                      SelectedItem="{Binding SelectedSubject}"
                      DisplayMemberPath="Title"
                      Width="250" Height="28"/>
        </StackPanel>

        <!-- Основное содержимое с вкладками -->
        <TabControl Grid.Row="2">
            <TabItem Header="Выставление оценок">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список учеников -->
                    <DataGrid Grid.Column="0" ItemsSource="{Binding Students}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedStudent}"
                              SelectionMode="Single" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group.Title}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Панель добавления/изменения оценки -->
                    <StackPanel Grid.Column="1" Width="80" Margin="10,0" VerticalAlignment="Top">
                        <TextBlock Text="Оценка:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox SelectedIndex="{Binding SelectedMarkValue, Converter={StaticResource IntToIndexConverter}}"
                                  Height="28" Width="60" Margin="0,0,0,10">
                            <ComboBoxItem>1</ComboBoxItem>
                            <ComboBoxItem>2</ComboBoxItem>
                            <ComboBoxItem>3</ComboBoxItem>
                            <ComboBoxItem>4</ComboBoxItem>
                            <ComboBoxItem>5</ComboBoxItem>
                        </ComboBox>

                        <Button Content="Добавить" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddMarkCommand}" Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="Выбранная оценка:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBlock Text="{Binding SelectedMark.Id, StringFormat='ID: {0}'}" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SelectedMark.Value, StringFormat='Значение: {0}'}" FontSize="12" Margin="0,0,0,10"/>

                        <Button Content="Изменить" Style="{StaticResource PrimaryButton}"
                                Command="{Binding UpdateMarkCommand}"
                                CommandParameter="{Binding SelectedMark.Id}"
                                Height="35" Margin="0,0,0,10"/>
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeleteMarkCommand}"
                                CommandParameter="{Binding SelectedMark.Id}"
                                Height="35"/>
                    </StackPanel>

                    <!-- Таблица оценок выбранного ученика -->
                    <DataGrid Grid.Column="2" ItemsSource="{Binding Marks}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectedItem="{Binding SelectedMark}"
                              Margin="10,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="90"/>
                            <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="60"/>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding Subject.Title}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="История изменений">
                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False"
                          IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding ChangeDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="Ученик" Binding="{Binding Mark.Student.FullName}" Width="*"/>
                        <DataGridTextColumn Header="Предмет" Binding="{Binding Mark.Subject.Title}" Width="*"/>
                        <DataGridTextColumn Header="Старое" Binding="{Binding OldValue}" Width="60"/>
                        <DataGridTextColumn Header="Новое" Binding="{Binding NewValue}" Width="60"/>
                        <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>