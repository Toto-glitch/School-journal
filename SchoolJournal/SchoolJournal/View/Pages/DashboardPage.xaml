<Page x:Class="SchoolJournal.View.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Приветствие -->
        <TextBlock Grid.Row="0" Text="{Binding WelcomeMessage}"
                   FontSize="24" FontWeight="Bold" Foreground="#4A90D9" Margin="0,0,0,20"/>

        <!-- Блок выбора ребёнка (только родитель) -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15"
                Visibility="{Binding IsParent, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Выберите ребёнка:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Children}"
                          SelectedItem="{Binding SelectedChild}"
                          DisplayMemberPath="FullName"
                          Width="250"/>
            </StackPanel>
        </Border>

        <!-- Прокручиваемая область -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Карточки -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <!-- Средний балл (ученик/родитель) -->
                    <Border Background="#4A90D9" CornerRadius="10" Padding="25" Margin="0,0,20,0"
                            Width="220" Height="120"
                            Visibility="{Binding IsTeacher, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel>
                            <TextBlock Text="Средний балл" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding StudentAverageMark}" Foreground="White"
                                       FontSize="36" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Мои предметы (учитель) -->
                    <Border Background="#5CB85C" CornerRadius="10" Padding="25" Margin="0,0,0,0"
                            MinWidth="250" MinHeight="120"
                            Visibility="{Binding IsTeacher, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Мои предметы" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding TeacherSubjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Средние баллы по предметам (ученик/родитель) -->
                <GroupBox Header="Средние баллы по предметам" Margin="0,20,0,0"
                          Visibility="{Binding IsStudentOrParent, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding SubjectAverages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Average, StringFormat=N2}" 
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- Последние оценки (ученик/родитель) -->
                <GroupBox Header="Последние оценки" Margin="0,20,0,0"
                          Visibility="{Binding IsStudentOrParent, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding RecentMarks}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding Subject.Title}" Width="*"/>
                            <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="80"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="120"/>
                            <DataGridTextColumn Header="Учитель" Binding="{Binding Teacher.LastName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>