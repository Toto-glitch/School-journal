<!-- DashboardPage.xaml -->
<Page x:Class="SchoolJournal.View.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Приветствие -->
        <TextBlock Grid.Row="0" Text="{Binding WelcomeMessage}"
                   FontSize="24" FontWeight="Bold" Foreground="#4A90D9" Margin="0,0,0,20"/>

        <!-- Блок выбора ребёнка (только для родителя) -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15"
                Visibility="{Binding IsParent, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Выберите ребёнка:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Children}"
                          SelectedItem="{Binding SelectedChild}"
                          DisplayMemberPath="FullName"
                          Width="250"/>
            </StackPanel>
        </Border>

        <!-- Информационные карточки -->
        <WrapPanel Grid.Row="2" Margin="0,20,0,0" Orientation="Horizontal">
            <!-- Средний балл -->
            <Border Background="#4A90D9" CornerRadius="10" Padding="25" Margin="0,0,20,20"
                    Width="220" Height="120">
                <StackPanel>
                    <TextBlock Text="Средний балл" Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding StudentAverageMark}" Foreground="White"
                               FontSize="36" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Другие карточки можно добавить позже -->
        </WrapPanel>

        <!-- Последние оценки -->
        <GroupBox Grid.Row="3" Header="Последние оценки" Margin="0,20,0,0">
            <DataGrid ItemsSource="{Binding RecentMarks}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Предмет" Binding="{Binding Subject.Title}" Width="*"/>
                    <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="80"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="120"/>
                    <DataGridTextColumn Header="Учитель" Binding="{Binding Teacher.LastName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Page>