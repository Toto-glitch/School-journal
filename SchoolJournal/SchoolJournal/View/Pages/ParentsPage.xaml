<Page x:Class="SchoolJournal.View.Pages.ParentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление родителями">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Список родителей" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
            <Button Content="+ Добавить родителя" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Padding="15,8"
                    Command="{Binding AddParentCommand}"
                    Visibility="{Binding IsDirector, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="{StaticResource CardBackground}" RowBackground="{StaticResource CardBackground}"
                  AlternatingRowBackground="#F8F9FA" BorderThickness="1" BorderBrush="#E0E0E0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding FatherName}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding User.Email}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding User.PhoneNumber}" Width="150"/>
                <DataGridTextColumn Header="Детей" Binding="{Binding Students.Count}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"
                    Visibility="{Binding IsDirector, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}"
                    Command="{Binding EditParentCommand}" Margin="0,0,10,0"/>
            <Button Content="Удалить" Style="{StaticResource SecondaryButton}"
                    Background="#FFE0E0" BorderBrush="#FFB3B3" Foreground="#333"
                    Command="{Binding DeleteParentCommand}"/>
        </StackPanel>

        <!-- Диалог добавления/редактирования -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="25"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="500"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, 
                               ConverterParameter='Редактирование родителя|Добавление родителя'}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" 
                               Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Width="200" Margin="0,0,10,0">
                            <TextBlock Text="Фамилия *" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                        <StackPanel Width="200">
                            <TextBlock Text="Имя *" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Отчество" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Логин" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Пароль" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Email" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Телефон" Foreground="{StaticResource GrayText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                    <!-- Выбор учеников -->
                    <TextBlock Text="Дети" Foreground="{StaticResource GrayText}" Margin="0,15,0,5"/>
                    <ListBox ItemsSource="{Binding AllStudents}" 
                             SelectionMode="Multiple"
                             Height="120" Margin="0,0,0,15"
                             SelectionChanged="StudentsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Для выбора нескольких удерживайте Ctrl" FontSize="11" Foreground="{StaticResource GrayText}" Margin="0,-10,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,15,0"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, 
                                        ConverterParameter='Сохранить|Добавить'}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>